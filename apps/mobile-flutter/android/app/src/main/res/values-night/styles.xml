<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OS의 dark mode 설정이 켜져 있을 때 process 시작 중 Android Window에 적용되는 theme입니다. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- activity에 splash screen을 표시합니다. Flutter engine이 첫 frame을 그리면 자동으로 제거됩니다. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- process가 시작되자마자 Android Window에 적용되는 theme입니다.
         Flutter UI 초기화 중과 실행 중 Flutter UI 뒤에 보이는 Android Window 색상을 결정합니다.

         이 theme는 Flutter Android embedding V2부터 사용됩니다. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
