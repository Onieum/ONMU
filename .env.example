# 공통
ONMU_ENV=local
ONMU_PUBLIC_BASE_URL=http://localhost:8080

# Azure Key Vault. 공유 dev/클라우드 secret은 각자 권한이 있는 vault에서 읽습니다.
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=koreacentral
AZURE_KEY_VAULT_NAME=
AZURE_LOG_ANALYTICS_WORKSPACE=

# API
API_PORT=8080
API_HOST=127.0.0.1
POSTGRES_HOST_PORT=15432
POSTGRES_PASSWORD=onmu-local-only
DATABASE_URL=postgresql://onmu:onmu-local-only@localhost:15432/onmu
REDIS_URL=redis://localhost:6379/0
# 객체 스토리지 provider. 로컬은 minio, 운영(VM)은 r2(=aws/s3/cloudflare 동의어).
# minio | azure_blob | r2
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=onmu-local
MINIO_ROOT_USER=onmu
MINIO_ROOT_PASSWORD=onmu-local-only
# R2(Cloudflare, S3 호환) 운영용 자격증명. OBJECT_STORAGE_PROVIDER=r2 일 때만 사용.
# .env.production(VM) 에서만 실제 값 주입. 예시 엔드포인트: https://<accountid>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OPENSEARCH_INITIAL_ADMIN_PASSWORD=onmu-local-only

# === VM 운영용 추가 변수 (docker-compose.prod-vm.yml + .env.production) ===
# Spring 은 jdbc URL 사용. Azure Flexible 은 SSL 필수 → sslmode=require.
# 예: jdbc:postgresql://onmu-staging-pg.postgres.database.azure.com:5432/onmu?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/onmu
SPRING_DATASOURCE_USERNAME=onmu
SPRING_DATASOURCE_PASSWORD=onmu-local-only
# 워커(psycopg)용 postgresql:// URL. 위 jdbc 호스트/비밀번호와 동일 대상.
# DATABASE_URL(상단)을 운영 DB 로 덮어쓴다.
ONMU_ACCESS_TOKEN_SECRET=

# MapLibre / PMTiles dev seed. 실제 PMTiles 파일은 커밋하지 않습니다.
ONMU_PMTILES_SOURCE_URL=
ONMU_TILE_BUCKET=onmu-tiles
ONMU_PMTILES_OBJECT_KEY=pmtiles/korea-dev.pmtiles
ONMU_TILE_MANIFEST_OBJECT_KEY=tiles/manifest.json
ONMU_TILE_STYLE_OBJECT_KEY=styles/onmu-light.json
ONMU_TILE_LOCAL_MANIFEST_URL=http://localhost:9000/onmu-tiles/tiles/manifest.json
ONMU_TILE_PUBLIC_MANIFEST_URL=https://tiles.onmu.cloud/manifest.json
ONMU_TILE_PUBLIC_BASE_URL=https://tiles.onmu.cloud
ONMU_TILE_MANIFEST_URL=https://tiles.onmu.cloud/manifest.json

# 로컬 서비스 경계
REALTIME_PORT=8081
WORKER_PORT=8090
BRAND_WEB_PORT=3000

# 선택 확장. 1차 MVP 기본값은 비활성입니다.
EVENT_BROKER_URL=
SEARCH_ENDPOINT=
AIRFLOW_BASE_URL=
CLOUDFLARE_DEV_API_HOSTNAME=dev-api.onmu.cloud
CLOUDFLARE_DEV_DB_HOSTNAME=db-dev.onmu.cloud
CLOUDFLARE_API_TOKEN=

# 외부 API
KAKAO_REST_API_KEY=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
OPENROUTESERVICE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# OAuth 로그인. secret 값은 로컬 .env 또는 Key Vault에서만 주입하고 앱 bundle에 넣지 않습니다.
KAKAO_OAUTH_REDIRECT_URI=https://dev-api.onmu.cloud/api/v1/auth/oauth/kakao/callback
KAKAO_OAUTH_LOGOUT_REDIRECT_URI=https://dev-api.onmu.cloud/api/v1/auth/oauth/kakao/logout/callback
KAKAO_OAUTH_MOBILE_CALLBACK_URI=io.onieum.onmu://oauth/kakao/callback
KAKAO_OAUTH_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=https://dev-api.onmu.cloud/api/v1/auth/oauth/naver/callback
NAVER_OAUTH_MOBILE_CALLBACK_URI=io.onieum.onmu://oauth/naver/callback

# push
FCM_PROJECT_ID=
APNS_TEAM_ID=

# Jira 자동화
JIRA_BASE_URL=https://onmu.atlassian.net
JIRA_PROJECT_KEY=SCRUM
JIRA_EMAIL=
JIRA_API_TOKEN=

# Notion 자동화
NOTION_TOKEN=
NOTION_WORKSPACE_HOME_URL=
