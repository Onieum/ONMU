{
  "name": "onmu",
  "private": true,
  "version": "0.1.0",
  "description": "ONMU 릴리스 아키텍처 작업 공간",
  "scripts": {
    "compose:config": "docker compose -f infra/compose/docker-compose.yml config",
    "compose:config:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 config",
    "compose:config:integration:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-integration-windows.ps1 config",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up -d postgres redis minio",
    "compose:up:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up",
    "compose:up:integration:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-integration-windows.ps1 up -UseKeyVault",
    "compose:up:windows:events": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up -IncludeEvents",
    "compose:up:windows:search": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up -IncludeSearch",
    "compose:up:windows:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up -IncludeEvents -IncludeSearch",
    "compose:ps": "docker compose -f infra/compose/docker-compose.yml ps",
    "compose:ps:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 ps",
    "compose:ps:integration:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-integration-windows.ps1 ps",
    "compose:down:integration:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-integration-windows.ps1 down",
    "api:dev": "cd services/api-spring && mvnw.cmd spring-boot:run",
    "api:integration:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/deploy-integration-backend.ps1",
    "api:integration:deploy:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/deploy-integration-backend.ps1 -DryRun",
    "api:integration:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/deploy-integration-backend.ps1 -StopOnly",
    "onprem:primary:preflight:mac": "bash scripts/macos/onprem-primary-preflight.sh",
    "onprem:primary:preflight:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/onprem-primary-preflight.ps1",
    "host:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1",
    "host:windows:keyvault": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -UseKeyVault",
    "host:windows:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -AllowLan",
    "host:windows:events": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -IncludeEvents",
    "host:windows:search": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -IncludeSearch",
    "host:windows:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -IncludeEvents -IncludeSearch",
    "tunnel:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1",
    "tunnel:cloudflare:access-tcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1 -AccessTcp",
    "tunnel:cloudflare:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1 -ApiPort 18080 -TunnelName onmu-int-api -Hostname int-api.onmu.cloud -ConfigFile infra/cloudflare/cloudflared-integration.yml",
    "tunnel:cloudflare:integration:access-tcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1 -ApiPort 18080 -TunnelName onmu-int-api -Hostname int-api.onmu.cloud -AccessTcpHostname db-int.onmu.cloud -AccessTcpPort 16432 -ConfigFile infra/cloudflare/cloudflared-integration-access-tcp.yml -AccessTcp",
    "db:access:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-db-access.ps1",
    "db:access:cloudflare:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-db-access.ps1 -Environment integration",
    "db:rotate-password:keyvault": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rotate-dev-db-password.ps1",
    "azure:keyvault:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-azure-key-vault.ps1",
    "azure:keyvault:set-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-azure-key-vault-secrets.ps1",
    "tunnel:cloudflare:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1 -Quick",
    "tunnel:cloudflare:info": "cloudflared --config infra/cloudflare/cloudflared-local.yml tunnel info onmu-dev-api",
    "tunnel:cloudflare:integration:info": "cloudflared --config infra/cloudflare/cloudflared-integration.yml tunnel info onmu-int-api",
    "jira:bootstrap": "node scripts/bootstrap-jira.mjs",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0"
  }
}
