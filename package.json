{
  "name": "onmu",
  "private": true,
  "version": "0.1.0",
  "description": "ONMU 릴리스 아키텍처 작업 공간",
  "scripts": {
    "compose:config": "docker compose -f infra/compose/docker-compose.yml config",
    "compose:config:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 config",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up -d postgres redis minio",
    "compose:up:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up",
    "compose:up:windows:events": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up -IncludeEvents",
    "compose:up:windows:search": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up -IncludeSearch",
    "compose:up:windows:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 up -IncludeEvents -IncludeSearch",
    "compose:ps": "docker compose -f infra/compose/docker-compose.yml ps",
    "compose:ps:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-windows.ps1 ps",
    "api:dev": "node services/api/server.mjs",
    "host:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1",
    "host:windows:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -AllowLan",
    "host:windows:events": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -IncludeEvents",
    "host:windows:search": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -IncludeSearch",
    "host:windows:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows-backend.ps1 -IncludeEvents -IncludeSearch",
    "tunnel:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1",
    "tunnel:cloudflare:access-tcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1 -AccessTcp",
    "db:access:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-db-access.ps1",
    "tunnel:cloudflare:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1 -Quick",
    "tunnel:cloudflare:info": "cloudflared --config infra/cloudflare/cloudflared-local.yml tunnel info onmu-dev-api",
    "jira:bootstrap": "node scripts/bootstrap-jira.mjs",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1"
  }
}
