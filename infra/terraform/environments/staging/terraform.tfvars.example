tenant_id     = "00000000-0000-0000-0000-000000000000"
location      = "koreacentral"
region_code   = "krc"
name_suffix   = "001"
owner         = "onmu-team"
cost_center   = "onmu-staging"
spring_api_image = "ghcr.io/onieum/onmu-api-spring:staging-placeholder"

create_resource_group        = false
existing_resource_group_name = "3dt-final-team1"

enabled_modules = {
  observability              = true
  container_registry         = true
  key_vault                  = false
  postgres                   = false
  redis                      = false
  storage                    = false
  cdn                        = false
  front_door                 = false
  eventhubs                  = false
  container_apps_environment = false
  container_apps             = false
  ai_foundation              = false
  diagnostics                = false
  rbac_assignments           = false
}

enabled_diagnostic_targets = {
  foundation = false
  redis      = false
  front_door = false
  ai         = false
}

worker_enabled                = false
ootd_generation_provider      = "mock"

# OOTD model values are intentionally supplied through Key Vault secretRefs,
# not through Terraform variables, so the team can swap models later without a
# Terraform code change.
# Required when ootd_generation_provider="azure_ml":
# - staging-hf-token
# - staging-ootd-model-id
# - staging-ootd-model-revision
# - staging-azureml-endpoint-url
# - staging-azureml-endpoint-key
# - staging-vision-endpoint-url
# - staging-vision-deployment-name
# - staging-vision-api-key
# - staging-vision-api-version

# Enable after Azure OpenAI quota/model availability is confirmed.
# vision_openai_deployment = {
#   name          = "onmu-ootd-vision"
#   model_name    = "gpt-4o"
#   model_version = "2024-11-20"
#   sku_name      = "Standard"
#   capacity      = 1
# }

# Actual password values must not be committed to git.
# When enabled_modules.postgres=true, pass it through
# TF_VAR_postgres_administrator_password or protected CI secrets.
